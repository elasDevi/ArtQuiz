# Node.js 24+. Copy to .env, then keep it outside version control.
PORT=3000
DATA_DIR=data
# Optional: override the initial password on a NEW database only (12+ characters).
# Otherwise sign in as profesor with Madridtoledo2026, then change it in the dashboard.
# Existing passwords are preserved on restart; this does not reset them.
# ADMIN_PASSWORD=
# AI is optional; all manual assessment features work without it.
# Google Gemini (select a model with free-tier quota in your AI Studio project):
AI_PROVIDER=gemini
# GEMINI_API_KEY=
# Select a model in /admin > Challenge & settings > Google Gemini > Load models.
# Optional fallback if no model has been saved in the dashboard:
# GEMINI_MODEL=
# OpenAI alternative: set AI_PROVIDER=openai and configure these instead.
# AI_API_KEY=
# AI_MODEL=gpt-4.1-mini
# Public HTTPS origin used in the student QR code (no /admin).
# PUBLIC_URL=https://prado.example.org
# Production behind exactly one trusted HTTPS reverse proxy:
# NODE_ENV=production
# TRUST_PROXY=1
